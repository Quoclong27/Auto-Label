# ============================================
# BACKEND ENVIRONMENT VARIABLES - EXAMPLE
# Copy this file to .env and fill in your values
# ============================================

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# LAN Access (optional - for local network sharing)
LAN_IP=

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Development Mode (set to 1 for local dev, 0 for production)
DEV_OAUTH_PERMISSIVE=0

# Admin (comma-separated emails for multiple admins)
ADMIN_EMAIL=admin@example.com

# Database
DATABASE_URL=sqlite+aiosqlite:///./app.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Secret Key (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=change-this-in-production-use-random-string

# Cloudinary (optional - for cloud storage)
USE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
